%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode
% Generated by cv-builder — a starting point for a motivational letter.
% Run `make export NAME=<company>` to get a copy you can customize per application.

\documentclass[{{ config.font_size }}, {{ config.paper }}]{awesome-cv}

\geometry{left=1.4cm, top=.8cm, right=1.4cm, bottom=1.8cm, footskip=.5cm}

\definecolor{awesome}{HTML}{ {{- highlight_color_hex -}} }
\setbool{acvSectionColorHighlight}{ {{- 'true' if config.section_color_highlight else 'false' -}} }
\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}
{% if config.text_color %}
\definecolor{text}{HTML}{ {{- config.text_color -}} }
{% endif %}
{% if config.secondary_text_color %}
\definecolor{graytext}{HTML}{ {{- config.secondary_text_color -}} }
{% endif %}


%--- Personal Information ---
{% if personal.photo %}
\photo[{{ personal.photo.shape }},{{ personal.photo.edge }},{{ personal.photo.align }}]{ {{- personal.photo.path -}} }
{% endif %}
\name{ {{- personal.name.first | le -}} }{ {{- personal.name.last | le -}} }
\position{ {{- personal.position | map('le') | join('{\\enskip\\cdotp\\enskip}') -}} }
{% if personal.address %}
\address{ {{- personal.address | le -}} }
{% endif %}
{% if personal.contact.mobile %}
\mobile{ {{- personal.contact.mobile | le -}} }
{% endif %}
{% if personal.contact.email %}
\email{ {{- personal.contact.email | le -}} }
{% endif %}
{% if personal.contact.website %}
\homepage{ {{- personal.contact.website | le -}} }
{% endif %}
{% if personal.social.github %}
\github{ {{- personal.social.github | le -}} }
{% endif %}
{% if personal.social.linkedin %}
\linkedin{ {{- personal.social.linkedin | le -}} }
{% endif %}
{% if personal.social.twitter %}
\twitter{ {{- personal.social.twitter | le -}} }
{% endif %}
{% if personal.social.gitlab %}
\gitlab{ {{- personal.social.gitlab | le -}} }
{% endif %}


%--- Letter Information ---
\recipient
  {Hiring Manager}
  {Company Name\\Street Address\\City, Country}
\letterdate{\today}
\lettertitle{Application for the position of [Job Title]}
\letteropening{Dear Hiring Manager,}
\letterclosing{Sincerely,}
\letterenclosure[Attached]{Curriculum Vitae}


\begin{document}

\makecvheader{% if config.resume.header_align %}[{{ config.resume.header_align }}]{% endif %}

\makecvfooter
  {\today}
  { {{- personal.name.first | le }} {{ personal.name.last | le }}~~~·~~~Motivational Letter}
  {}

\makelettertitle

\begin{cvletter}

\lettersection{About Me}
Who you are and why you are applying for this position.

\lettersection{Why [Company]?}
What draws you to this company and this role.

\lettersection{Why Me?}
What you bring: relevant experience, skills and results.

\end{cvletter}

\makeletterclosing

\end{document}
