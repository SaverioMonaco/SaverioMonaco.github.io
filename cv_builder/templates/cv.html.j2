<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ personal.name.first|e }} {{ personal.name.last|e }} · CV</title>
<!-- Generated by cv-builder — edit data/personal.yaml and data/cv/*.yaml instead of this file. -->
<script>
  (function () {
    try {
      var stored = localStorage.getItem('cv-theme');
      if (stored) document.documentElement.setAttribute('data-theme', stored);
    } catch (e) {}
  })();
</script>
<style>
  :root {
    --accent: {{ highlight_color }};
    --text: {{ text_color }};
    --secondary: {{ secondary_color }};
    --bg: #ffffff;
    --card-bg: #ffffff;
    --border: #e3e3e5;
    --chip-bg: #f4f4f6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161a;
      --card-bg: #1c1f24;
      --border: #2c2f36;
      --chip-bg: #22252b;
      --text: #e8e8e8;
      --secondary: #a6a6a6;
    }
  }
  /* Explicit theme choice (via the toggle button) overrides the OS preference above. */
  :root[data-theme="dark"] {
    --bg: #14161a;
    --card-bg: #1c1f24;
    --border: #2c2f36;
    --chip-bg: #22252b;
    --text: #e8e8e8;
    --secondary: #a6a6a6;
  }
  :root[data-theme="light"] {
    --bg: #ffffff;
    --card-bg: #ffffff;
    --border: #e3e3e5;
    --chip-bg: #f4f4f6;
    --text: {{ text_color }};
    --secondary: {{ secondary_color }};
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
  }
  .page {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 4rem;
  }
  a { color: inherit; }

  /* Theme toggle */
  .theme-toggle {
    position: fixed;
    top: clamp(.75rem, 3vw, 1.25rem);
    right: clamp(.75rem, 3vw, 1.25rem);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--chip-bg);
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .15s ease, transform .15s ease;
    z-index: 10;
  }
  .theme-toggle:hover, .theme-toggle:focus-visible { border-color: var(--accent); transform: translateY(-1px); }

  /* Top nav */
  .top-nav {
    position: fixed;
    top: clamp(.75rem, 3vw, 1.25rem);
    left: clamp(.75rem, 3vw, 1.25rem);
    display: flex;
    gap: .5rem;
    z-index: 10;
  }

  /* Header */
  .cv-header { text-align: center; margin-top: 2.75rem; margin-bottom: 2.25rem; }
  .cv-photo {
    width: 7.5rem;
    height: 7.5rem;
    object-fit: cover;
    margin: 0 auto .9rem;
    display: block;
    border: 3px solid var(--card-bg);
    box-shadow: 0 0 0 3px var(--accent);
  }
  .cv-photo.shape-circle { border-radius: 50%; }
  .cv-photo.shape-square { border-radius: 16px; }
  .cv-header h1 {
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    margin: 0 0 .2rem;
    letter-spacing: .01em;
  }
  .cv-header .position {
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 .9rem;
    font-size: clamp(.95rem, 2.4vw, 1.1rem);
  }
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    margin-bottom: .8rem;
  }
  .chip {
    display: inline-block;
    padding: .3rem .75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--chip-bg);
    font-size: .85rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color .15s ease, color .15s ease, transform .15s ease;
  }
  a.chip:hover, a.chip:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }
  .quote {
    font-style: italic;
    color: var(--secondary);
    max-width: 40em;
    margin: .6rem auto 0;
  }

  /* Sections */
  section.cv-section { margin-bottom: 2rem; }
  .section-title {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 700;
    margin: 0 0 .9rem;
    padding-bottom: .3rem;
    border-bottom: 2px solid var(--border);
  }
  .section-title.highlighted {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .section-title-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }
  .section-title-toggle .section-count { color: var(--secondary); font-weight: 400; }
  .section-title-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .section-toggle-icon {
    color: var(--accent);
    font-size: .8rem;
    transition: transform .2s ease;
  }
  .cv-section.collapsible .section-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height .25s ease, opacity .2s ease;
  }
  .cv-section.collapsible.expanded .section-body {
    max-height: 300em;
    opacity: 1;
    margin-top: .9rem;
  }
  .cv-section.collapsible.expanded .section-toggle-icon { transform: rotate(180deg); }
  .subsection {
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--secondary);
    margin: 1rem 0 .5rem;
  }

  /* Entry cards (education, experience, presentation, extracurricular, writing) */
  .entry {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: .85rem 1rem;
    margin-bottom: .6rem;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .entry[tabindex] { cursor: pointer; }
  .entry:hover, .entry:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(0, 0, 0, .07);
  }
  .entry:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .entry.entry-tbd {
    background: transparent;
    border: 1px dashed var(--border);
    opacity: .6;
  }
  .entry.entry-tbd:hover, .entry.entry-tbd:focus-visible {
    opacity: 1;
    border-color: var(--accent);
    box-shadow: none;
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: .75rem;
  }
  .entry-titles { min-width: 0; flex: 1 1 auto; }
  .entry-title { font-weight: 700; }
  .entry-title-link { font-weight: 700; text-decoration: none; color: var(--text); }
  .entry-title-link:hover, .entry-title-link:focus-visible { color: var(--accent); }
  .entry-pdf-badge {
    display: inline-block;
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0 .45rem;
    margin-left: .4rem;
    vertical-align: middle;
  }
  .entry-org { display: block; color: var(--secondary); font-size: .92rem; }
  .entry-meta { display: flex; align-items: baseline; gap: .5rem; white-space: nowrap; flex: 0 0 auto; }
  .entry-dates { color: var(--secondary); font-size: .85rem; }
  .entry-toggle {
    display: inline-block;
    color: var(--accent);
    font-size: .8rem;
    transition: transform .2s ease;
  }
  .entry-details {
    list-style: disc;
    margin: 0;
    padding-left: 1.15rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height .25s ease, opacity .2s ease, margin-top .25s ease;
  }
  .entry-details li { margin: .15rem 0; font-size: .92rem; }
  .entry.expanded .entry-details {
    max-height: 60em;
    opacity: 1;
    margin-top: .55rem;
  }
  .entry.expanded .entry-toggle { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) {
    .entry:hover .entry-details {
      max-height: 60em;
      opacity: 1;
      margin-top: .55rem;
    }
    .entry:hover .entry-toggle { transform: rotate(180deg); }
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: .9rem 1.4rem;
  }
  .skill-category {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--secondary);
    margin: 0 0 .4rem;
  }
  .skill-tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .tag {
    font-size: .82rem;
    padding: .2rem .6rem;
    border-radius: 999px;
    background: var(--chip-bg);
    border: 1px solid var(--border);
    transition: border-color .15s ease, transform .15s ease, color .15s ease;
  }
  .tag:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }

  /* Publications */
  .pub-list { display: flex; flex-direction: column; gap: .9rem; }
  .pub { display: flex; gap: .9rem; }
  .pub-year { flex: 0 0 auto; min-width: 3em; font-weight: 700; color: var(--accent); }
  .pub-body { min-width: 0; }
  .pub-title { font-weight: 600; }
  .pub-authors { color: var(--secondary); font-size: .9rem; margin-top: .1rem; }
  .pub-authors .self { font-weight: 700; color: var(--text); }
  .pub-venue { color: var(--secondary); font-size: .85rem; font-style: italic; margin-top: .1rem; }
  .pub-links { margin-top: .3rem; display: flex; gap: .5rem; }
  .pub-links a {
    font-size: .78rem;
    padding: .12rem .55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color .15s ease, color .15s ease;
  }
  .pub-links a:hover { border-color: var(--accent); color: var(--accent); }

  /* Honors / certificates / committees */
  .honor-list { display: flex; flex-direction: column; gap: .45rem; }
  .honor-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: .75rem;
    flex-wrap: wrap;
    padding: .3rem 0;
    border-bottom: 1px solid var(--border);
  }
  .honor-main { display: flex; flex-direction: column; min-width: 0; }
  .honor-title { font-weight: 600; }
  .honor-event { color: var(--secondary); font-size: .88rem; }
  .honor-side { display: flex; flex-direction: column; align-items: flex-end; text-align: right; white-space: nowrap; }
  .honor-location { color: var(--secondary); font-size: .85rem; }
  .honor-year { font-size: .85rem; }

  /* Upcoming goals (HTML-only) — deliberately de-emphasized vs. the rest of the CV */
  .cv-section-muted {
    opacity: .6;
    transition: opacity .2s ease;
  }
  .cv-section-muted:hover, .cv-section-muted:focus-within {
    opacity: 1;
  }
  .upcoming-list { display: flex; flex-direction: column; gap: .6rem; }
  .upcoming-item {
    display: flex;
    align-items: baseline;
    gap: .75rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    padding: .75rem 1rem;
  }
  .upcoming-badge {
    flex: 0 0 auto;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: .1rem .55rem;
  }
  .upcoming-body { min-width: 0; flex: 1 1 auto; }
  .upcoming-title { font-weight: 600; }
  .upcoming-note { color: var(--secondary); font-size: .88rem; }
  .upcoming-target { color: var(--secondary); font-size: .82rem; white-space: nowrap; flex: 0 0 auto; }

  .page-footer {
    margin-top: 2rem;
    text-align: center;
  }
  .pdf-link {
    display: inline-block;
    font-size: .85rem;
    color: var(--secondary);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: .4rem 1rem;
    transition: border-color .15s ease, color .15s ease;
  }
  .pdf-link:hover, .pdf-link:focus-visible { border-color: var(--accent); color: var(--accent); }

  @media print {
    .entry-details { max-height: none !important; opacity: 1 !important; margin-top: .55rem !important; }
    .entry-toggle { display: none; }
    .entry { break-inside: avoid; }
    .theme-toggle { display: none; }
    .top-nav { display: none; }
    .page-footer { display: none; }
    .section-body { max-height: none !important; opacity: 1 !important; margin-top: .9rem !important; }
    .section-toggle-icon { display: none; }
  }
</style>
</head>
<body>
<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">🌙</button>
<nav class="top-nav">
  <a class="chip" href="projects/">Projects</a>
  <a class="chip" href="thesis.html">Thesis</a>
  <a class="chip" href="gym.html">Gym</a>
</nav>
<div class="page">

  <header class="cv-header">
    {% if photo %}
    <img class="cv-photo shape-{{ photo.shape }}" src="{{ photo.data_uri }}" alt="Photo of {{ personal.name.first|e }} {{ personal.name.last|e }}">
    {% endif %}
    <h1>{{ personal.name.first|e }} {{ personal.name.last|e }}</h1>
    {% if personal.position %}
    <p class="position">{{ personal.position|map('e')|join(' · ') }}</p>
    {% endif %}
    <div class="contact-row">
      {% if personal.address %}<span class="chip">{{ personal.address|e }}</span>{% endif %}
      {% if personal.contact.email %}<a class="chip" href="mailto:{{ personal.contact.email|e }}">{{ personal.contact.email|e }}</a>{% endif %}
      {% if personal.contact.mobile %}<a class="chip" href="tel:{{ personal.contact.mobile|e }}">{{ personal.contact.mobile|e }}</a>{% endif %}
      {% if personal.contact.website %}<a class="chip" href="https://{{ personal.contact.website|e }}" target="_blank" rel="noopener">{{ personal.contact.website|e }}</a>{% endif %}
      {% if personal.social.github %}<a class="chip" href="https://github.com/{{ personal.social.github|e }}" target="_blank" rel="noopener">GitHub</a>{% endif %}
      {% if personal.social.linkedin %}<a class="chip" href="https://linkedin.com/in/{{ personal.social.linkedin|e }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
      {% if personal.social.twitter %}<a class="chip" href="https://twitter.com/{{ personal.social.twitter|e }}" target="_blank" rel="noopener">Twitter</a>{% endif %}
      {% if personal.social.gitlab %}<a class="chip" href="https://gitlab.com/{{ personal.social.gitlab|e }}" target="_blank" rel="noopener">GitLab</a>{% endif %}
      {% if personal.contact.whatsapp %}<a class="chip" href="https://wa.me/{{ personal.contact.whatsapp|e }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}
    </div>
    {% if personal.quote %}<p class="quote">“{{ personal.quote|e }}”</p>{% endif %}
  </header>

  {% for section in sections %}
  <section class="cv-section{{ ' collapsible' if section.collapsible else '' }}">
    <h2 class="section-title{{ ' highlighted' if section_color_highlight else '' }}{{ ' section-title-toggle' if section.collapsible else '' }}"{% if section.collapsible %} tabindex="0" role="button" aria-expanded="false"{% endif %}>
      {% if section.collapsible %}
      <span>{{ section.title|e }} <span class="section-count">({{ (section.entries if section.kind == 'entries' else section.publications)|length }})</span></span>
      <span class="section-toggle-icon" aria-hidden="true">▾</span>
      {% else %}
      {{ section.title|e }}
      {% endif %}
    </h2>

    <div class="section-body">
    {% if section.kind == 'entries' %}
      {% for entry in section.entries %}
      <article class="entry{{ ' entry-tbd' if entry.tbd else '' }}"{% if entry.bullets %} tabindex="0" aria-expanded="false"{% endif %}>
        <div class="entry-head">
          <div class="entry-titles">
            {% if entry.pdf %}
            <a class="entry-title-link" href="{{ entry.pdf|e }}" target="_blank" rel="noopener">{{ entry.title|e }}<span class="entry-pdf-badge">PDF</span></a>
            {% else %}
            <span class="entry-title">{{ entry.title|e }}</span>
            {% endif %}
            {% if entry.organization or entry.location %}
            <span class="entry-org">{{ entry.organization|e }}{% if entry.organization and entry.location %} · {% endif %}{{ entry.location|e }}</span>
            {% endif %}
          </div>
          <div class="entry-meta">
            <span class="entry-dates">{{ entry.dates|e }}</span>
            {% if entry.bullets %}<span class="entry-toggle" aria-hidden="true">▾</span>{% endif %}
          </div>
        </div>
        {% if entry.bullets %}
        <ul class="entry-details">
          {% for item in entry.bullets %}<li>{{ item|e }}</li>{% endfor %}
        </ul>
        {% endif %}
      </article>
      {% endfor %}

    {% elif section.kind == 'skills' %}
      <div class="skills-grid">
        {% for group in section.skills %}
        <div class="skill-group">
          <h3 class="skill-category">{{ group.category|e }}</h3>
          <div class="skill-tags">
            {% for s in group.skills %}<span class="tag">{{ s|e }}</span>{% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>

    {% elif section.kind == 'publications' %}
      <div class="pub-list">
        {% for pub in section.publications %}
        <div class="pub">
          <div class="pub-year">{{ pub.year|e }}</div>
          <div class="pub-body">
            <div class="pub-title">{{ pub.title|e }}</div>
            {% if pub.authors %}
            <div class="pub-authors">
              {% for a in pub.authors %}<span class="{{ 'self' if a.is_self else '' }}">{{ a.text|e }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
            </div>
            {% endif %}
            {% if pub.venue %}<div class="pub-venue">{{ pub.venue|e }}</div>{% endif %}
            {% if pub.doi or pub.url %}
            <div class="pub-links">
              {% if pub.doi %}<a href="https://doi.org/{{ pub.doi|e }}" target="_blank" rel="noopener">DOI</a>{% endif %}
              {% if pub.url %}<a href="{{ pub.url|e }}" target="_blank" rel="noopener">Link</a>{% endif %}
            </div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>

    {% elif section.kind == 'honors' %}
      {% for group in section.groups %}
        {% if group.subsection %}<h3 class="subsection">{{ group.subsection|e }}</h3>{% endif %}
        <div class="honor-list">
          {% for a in group.awards %}
          <div class="honor-row">
            <div class="honor-main">
              <span class="honor-title">{{ a.col1|e }}</span>
              {% if a.col2 %}<span class="honor-event">{{ a.col2|e }}</span>{% endif %}
            </div>
            <div class="honor-side">
              {% if a.col3 %}<span class="honor-location">{{ a.col3|e }}</span>{% endif %}
              {% if a.col4 %}<span class="honor-year">{{ a.col4|e }}</span>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      {% endfor %}
    {% endif %}
    </div>
  </section>
  {% endfor %}

  {% if upcoming %}
  <section class="cv-section cv-section-muted">
    <h2 class="section-title{{ ' highlighted' if section_color_highlight else '' }}">Upcoming</h2>
    <div class="upcoming-list">
      {% for item in upcoming %}
      <div class="upcoming-item">
        <span class="upcoming-badge">Goal</span>
        <div class="upcoming-body">
          <div class="upcoming-title">{{ item.title|e }}</div>
          {% if item.note %}<div class="upcoming-note">{{ item.note|e }}</div>{% endif %}
        </div>
        {% if item.target %}<span class="upcoming-target">{{ item.target|e }}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <footer class="page-footer">
    <a class="pdf-link" href="cv.pdf">Download PDF version</a>
  </footer>

</div>
<script>
  document.querySelectorAll('.entry-title-link').forEach(function (link) {
    link.addEventListener('click', function (e) { e.stopPropagation(); });
  });

  document.querySelectorAll('.section-title-toggle').forEach(function (title) {
    var section = title.closest('.cv-section');
    function toggle() {
      var open = section.classList.toggle('expanded');
      title.setAttribute('aria-expanded', String(open));
    }
    title.addEventListener('click', toggle);
    title.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });

  document.querySelectorAll('.entry[tabindex]').forEach(function (entry) {
    function toggle() {
      var open = entry.classList.toggle('expanded');
      entry.setAttribute('aria-expanded', String(open));
    }
    entry.addEventListener('click', toggle);
    entry.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  });

  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');

    function isDark() {
      var explicit = root.getAttribute('data-theme');
      if (explicit) return explicit === 'dark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function render() {
      btn.textContent = isDark() ? '☀️' : '🌙';
      btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
    }
    btn.addEventListener('click', function () {
      var next = isDark() ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('cv-theme', next); } catch (e) {}
      render();
    });
    render();
  })();
</script>
</body>
</html>
