\definecolor{awesome}{HTML}{ {{- highlight_color_hex -}} }
\setbool{acvSectionColorHighlight}{ {{- 'true' if config.section_color_highlight else 'false' -}} }
\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}
{% if config.text_color %}
\definecolor{text}{HTML}{ {{- config.text_color -}} }
{% endif %}
{% if config.secondary_text_color %}
\definecolor{graytext}{HTML}{ {{- config.secondary_text_color -}} }
{% endif %}

{% raw %}%--- Typography: one family (Source Sans Pro) and a calmer hierarchy ---
% awesome-cv mixes Roboto (header) with Source Sans Pro (body) and uses
% small caps, slanted text and light weights for different lines; these
% overrides keep a single family, regular weights and fewer styles.
\renewcommand*{\headerfont}{\sffamily}
\renewcommand*{\headerfontlight}{\sffamily\fontseries{l}\selectfont}
\renewcommand*{\bodyfontlight}{\sffamily}% regular instead of light: light is too faint at 9pt
\renewcommand*{\headerfirstnamestyle}[1]{{\fontsize{30pt}{1em}\headerfontlight\color{text} #1}}
\renewcommand*{\headerlastnamestyle}[1]{{\fontsize{30pt}{1em}\headerfont\bfseries\color{text} #1}}
\renewcommand*{\headerpositionstyle}[1]{{\fontsize{9.5pt}{1em}\bodyfont\color{awesome} #1}}
\renewcommand*{\headeraddressstyle}[1]{{\fontsize{8.5pt}{1em}\headerfont\color{lighttext} #1}}
\renewcommand*{\headersocialstyle}[1]{{\fontsize{8.5pt}{1em}\headerfont\color{text} #1}}
\renewcommand*{\footerstyle}[1]{{\fontsize{8pt}{1em}\footerfont\color{lighttext} #1}}
\renewcommand*{\sectionstyleface}[1]{{\fontsize{15pt}{1em}\bodyfont\bfseries #1}}
\renewcommand*{\subsectionstyle}[1]{{\fontsize{11pt}{1em}\bodyfont\bfseries\textcolor{text}{#1}}}
\renewcommand*{\entrytitlestyle}[1]{{\fontsize{10pt}{1em}\bodyfont\bfseries\color{text} #1}}
\renewcommand*{\entrypositionstyle}[1]{{\fontsize{9pt}{1em}\bodyfont\itshape\color{darktext} #1}}
\renewcommand*{\entrydatestyle}[1]{{\fontsize{8.5pt}{1em}\bodyfont\color{darktext} #1}}
\renewcommand*{\entrylocationstyle}[1]{{\fontsize{9pt}{1em}\bodyfont\color{awesome} #1}}
\renewcommand*{\descriptionstyle}[1]{{\fontsize{9pt}{1em}\bodyfont\upshape\color{text} #1}}
\renewcommand*{\subentrypositionstyle}[1]{{\fontsize{8pt}{1em}\bodyfont\itshape\color{darktext} #1}}
\renewcommand*{\subentrydatestyle}[1]{{\fontsize{8pt}{1em}\bodyfont\color{darktext} #1}}
\renewcommand*{\subentrylocationstyle}[1]{{\fontsize{8pt}{1em}\bodyfont\color{awesome} #1}}
\renewcommand*{\honordatestyle}[1]{{\fontsize{9pt}{1em}\bodyfont\color{darktext} #1}}
\renewcommand*{\honorlocationstyle}[1]{{\fontsize{9pt}{1em}\bodyfont\color{awesome} #1}}
\renewcommand*{\skilltypestyle}[1]{{\fontsize{9.5pt}{1em}\bodyfont\bfseries\color{text} #1}}
\renewcommand*{\skillsetstyle}[1]{{\fontsize{9pt}{1em}\bodyfont\color{text} #1}}
% Never leave a section title alone at the bottom of a page
\usepackage{needspace}
\renewcommand{\cvsection}[2][\acvSectionTopSkip]{%
  \Needspace{8\baselineskip}%
  \vspace{#1}
  \sectionstyle{#2}
  \phantomsection
  {\color{awesome}\vhrulefill{0.9pt}}
}
% Talks/posters: year in the accent color, bold title, venue in small grey
% italic (like the degree/role line of other entries); wrapped lines are
% indented under the title.
\renewcommand*{\cvcompactentry}[3]{%
  \par\small
  \hangindent=\acvCompactEntryIndent\hangafter=1
  \makebox[\acvCompactEntryIndent][l]{\bfseries\color{awesome}#1}{\bfseries\color{text}#2}%
  \par
  \hangindent=\acvCompactEntryIndent\hangafter=0
  {\fontsize{8.5pt}{1.2em}\selectfont\itshape\color{darktext}#3}%
  \par\vspace{0.35\baselineskip}%
}
{% endraw %}


