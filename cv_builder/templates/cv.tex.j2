{% raw %}%--- Bibliography (Publications section) ---
\usepackage[
  sorting=ydnt,
  style=authoryear,
  doi=false,
  isbn=false,
  url=false,
  eprint=false,
  maxbibnames=99,
  hyperref=true,
  block=none,
  backend=biber
]{biblatex}
\addbibresource{cv/bib.bib}

\DeclareFieldFormat[article,inproceedings,misc,report,incollection]{title}{#1\par}

\DeclareBibliographyDriver{article}{%
  \small
  \textbf{\printfield{year}}\hspace{.2cm}%
  \printfield{title}%
  \newblock%
  \hspace{.51cm}\printnames[acvbibauthor]{author}%
  \par%
  \newblock%
  \hspace{.45cm}{%
    \small\color{graytext}%
    \usebibmacro{journal+issuetitle}%
    \setunit{\space}%
    \printfield{pages}%
    \newunit%
    \printlist{publisher}%
    \setunit*{\addcomma\space}%
    \newunit%
  }%
  \par\vspace{0.12\baselineskip}%
}

\DeclareBibliographyDriver{inproceedings}{%
  \small
  \textbf{\printfield{year}}\hspace{.2cm}%
  \printfield{title}%
  \newblock%
  \hspace{.51cm}\printnames[acvbibauthor]{author}%
  \par%
  \newblock%
  \hspace{.45cm}{%
    \small\color{graytext}%
    \printfield{booktitle}%
    \setunit{\addcomma\space}%
    \printfield{year}%
    \setunit{\addcomma\space}%
    \printlist{location}%
    \newunit%
  }%
  \par\vspace{0.12\baselineskip}%
}

% Bold your own name in author lists (driven by personal.yaml)
\renewcommand*{\mkbibnamefamily}[1]{\ifdefstring{#1}{{% endraw %}{{ personal.name.last | le }}{% raw %}}{\textbf{#1}}{#1}}

\DeclareNameFormat{acvbibauthor}{%
  \renewcommand*{\multinamedelim}{\addcomma\addspace}%
  \nameparts{#1}%
  \namepartgiven\space\mkbibnamefamily{\namepartfamily}%
  \ifthenelse{\value{listcount}<\value{liststop}}{\addcomma\space}{}%
}
{% endraw %}

