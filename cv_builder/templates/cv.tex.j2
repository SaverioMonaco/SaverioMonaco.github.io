\DeclareFieldFormat[article,inproceedings,misc,report,incollection]{title}{#1}
\DeclareFieldFormat{journaltitle}{#1}
\DeclareFieldFormat{shortjournal}{#1}

% Two-line entry with the right column pinned to the top: place/journal on
% the first line of the title, date/year right below it, even when the title
% wraps (\cventry centers the right column vertically instead).
%   #1 title             #3 place / journal (accent)
%   #2 subtitle          #4 date / year
% A thin accent corner (an "L") marks the bottom-left of each entry so entries
% are easy to tell apart.
\newsavebox{\acvstackbox}
\newcommand*{\acvstackcorner}{%
  {\color{awesome!30}\rule{0.4pt}{2.2mm}\rule{3mm}{0.4pt}}}
\newcommand*{\acvstackentry}[4]{%
  \noindent% no \par here: inside the bibliography list it would add an empty line after \item
  \sbox{\acvstackbox}{%
    \parbox[t]{\dimexpr\textwidth-4.7cm\relax}{%
      \fontsize{9pt}{12pt}\selectfont\raggedright #1\par #2}%
    \hspace{2mm}%
    \parbox[t]{4.5cm}{%
      \fontsize{9pt}{12pt}\selectfont\raggedleft #3\par #4}}%
  \rlap{\hspace{-1.8mm}\raisebox{\dimexpr-\dp\acvstackbox-0.9mm\relax}{\acvstackcorner}}%
  \usebox{\acvstackbox}%
  \par\vspace{2.2mm}%
}

% The bibliography is a plain list: no hanging indent or extra item spacing
% (spacing comes from \acvstackentry, like talks/posters)
\defbibenvironment{bibliography}
  {\list{}{\setlength{\leftmargin}{0pt}\setlength{\itemindent}{0pt}%
           \setlength{\labelwidth}{0pt}\setlength{\labelsep}{0pt}%
           \setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}}
  {\endlist}
  {\item}
\setlength{\bibitemsep}{0pt}
\renewbibmacro*{finentry}{}% no end-of-entry period/paragraph

% Publications: title (bold) / authors (grey), journal + volume / year on the right
\newcommand*{\acvpubentry}[4]{%
  \acvstackentry
    {\entrytitlestyle{#1}}
    {{\fontsize{9pt}{1.2em}\bodyfont\color{darktext}#2}}
    {\entrylocationstyle{#3}}
    {\entrydatestyle{#4}}%
}

\DeclareBibliographyDriver{article}{%
  \acvpubentry
    {\printfield{title}}
    {\printnames[acvbibauthor]{author}}
    {\iffieldundef{shortjournal}{\printfield{journaltitle}}{\printfield{shortjournal}}%
     \iffieldundef{volume}{}{\addspace\printfield{volume}}}
    {\printfield{year}}%
}

\DeclareBibliographyDriver{inproceedings}{%
  \acvpubentry
    {\printfield{title}}
    {\printnames[acvbibauthor]{author}}
    {\printfield{booktitle}}
    {\printfield{year}}%
}

% Bold your own name in author lists (driven by personal.yaml)
\renewcommand*{\mkbibnamefamily}[1]{\ifdefstring{#1}{{% endraw %}{{ personal.name.last | le }}{% raw %}}{\textbf{#1}}{#1}}

\DeclareNameFormat{acvbibauthor}{%
  \renewcommand*{\multinamedelim}{\addcomma\addspace}%
  \nameparts{#1}%
  \namepartgiven\space\mkbibnamefamily{\namepartfamily}%
  \ifthenelse{\value{listcount}<\value{liststop}}{\addcomma\space}{}%
}
