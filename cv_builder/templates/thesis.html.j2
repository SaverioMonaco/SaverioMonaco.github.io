<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ personal.name.first|e }}'s PhD Thesis</title>
<!-- Generated by cv-builder from data/thesis.yaml — edit that file, not this one. -->
<script>
  (function () {
    try {
      var stored = localStorage.getItem('cv-theme');
      if (stored) document.documentElement.setAttribute('data-theme', stored);
    } catch (e) {}
  })();
</script>
<style>
  :root {
    --accent: {{ highlight_color }};
    --text: {{ text_color }};
    --secondary: {{ secondary_color }};
    --bg: #ffffff;
    --card-bg: #ffffff;
    --border: #e3e3e5;
    --chip-bg: #f4f4f6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161a;
      --card-bg: #1c1f24;
      --border: #2c2f36;
      --chip-bg: #22252b;
      --text: #e8e8e8;
      --secondary: #a6a6a6;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14161a;
    --card-bg: #1c1f24;
    --border: #2c2f36;
    --chip-bg: #22252b;
    --text: #e8e8e8;
    --secondary: #a6a6a6;
  }
  :root[data-theme="light"] {
    --bg: #ffffff;
    --card-bg: #ffffff;
    --border: #e3e3e5;
    --chip-bg: #f4f4f6;
    --text: {{ text_color }};
    --secondary: {{ secondary_color }};
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
  }
  .page {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 4rem;
  }
  a { color: inherit; }

  .theme-toggle {
    position: fixed;
    top: clamp(.75rem, 3vw, 1.25rem);
    right: clamp(.75rem, 3vw, 1.25rem);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--chip-bg);
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .15s ease, transform .15s ease;
    z-index: 10;
  }
  .theme-toggle:hover, .theme-toggle:focus-visible { border-color: var(--accent); transform: translateY(-1px); }

  .top-nav {
    position: fixed;
    top: clamp(.75rem, 3vw, 1.25rem);
    left: clamp(.75rem, 3vw, 1.25rem);
    display: flex;
    gap: .5rem;
    z-index: 10;
  }
  .chip {
    display: inline-block;
    padding: .3rem .75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--chip-bg);
    font-size: .85rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color .15s ease, color .15s ease, transform .15s ease;
  }
  a.chip:hover, a.chip:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .thesis-header { text-align: center; margin-top: 2.75rem; margin-bottom: 2.25rem; }
  .thesis-header h1 {
    font-size: clamp(1.5rem, 4.5vw, 2.2rem);
    margin: 0 0 .3rem;
    letter-spacing: .01em;
  }
  .thesis-header .subtitle {
    color: var(--secondary);
    font-style: italic;
    font-size: clamp(.95rem, 2.4vw, 1.1rem);
    margin: 0 0 .9rem;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .5rem;
    margin-bottom: .5rem;
  }
  .draft-badge {
    display: inline-block;
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: .1rem .55rem;
    margin-top: .3rem;
  }

  section.thesis-section { margin-bottom: 2rem; }
  .section-title {
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 700;
    margin: 0 0 .9rem;
    padding-bottom: .3rem;
    border-bottom: 2px solid var(--border);
  }
  .section-title.highlighted {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .abstract-text {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.15rem;
    white-space: pre-line;
  }

  .chapter-list { display: flex; flex-direction: column; gap: .6rem; }
  .chapter {
    display: flex;
    gap: .9rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: .85rem 1.05rem;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .chapter:hover { border-color: var(--accent); box-shadow: 0 2px 12px rgba(0, 0, 0, .07); }
  .chapter-number {
    flex: 0 0 auto;
    font-weight: 700;
    color: var(--accent);
    min-width: 1.6em;
  }
  .chapter-body { min-width: 0; }
  .chapter-title { font-weight: 700; margin-bottom: .2rem; }
  .chapter-text { color: var(--secondary); font-size: .92rem; white-space: pre-line; }

  .figure-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .chapter-body .figure-grid {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    margin-top: .75rem;
  }
  .figure-card { min-width: 0; }
  .figure-card a { display: block; }
  .figure-card img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card-bg);
    transition: border-color .15s ease;
  }
  .figure-card a:hover img, .figure-card a:focus-visible img { border-color: var(--accent); }
  .figure-caption {
    color: var(--secondary);
    font-size: .8rem;
    margin-top: .4rem;
  }

  .page-footer {
    margin-top: 2rem;
    text-align: center;
  }
  .pdf-link {
    display: inline-block;
    font-size: .85rem;
    color: var(--secondary);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: .4rem 1rem;
    transition: border-color .15s ease, color .15s ease;
  }
  .pdf-link:hover, .pdf-link:focus-visible { border-color: var(--accent); color: var(--accent); }

  @media print {
    .theme-toggle { display: none; }
    .top-nav { display: none; }
    .page-footer { display: none; }
  }
</style>
</head>
<body>
<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">🌙</button>
<nav class="top-nav">
  <a class="chip" href="index.html">Home</a>
  <a class="chip" href="projects/">Projects</a>
</nav>
<div class="page">

  <header class="thesis-header">
    <h1>{{ thesis.title|e }}</h1>
    {% if thesis.subtitle %}<p class="subtitle">{{ thesis.subtitle|e }}</p>{% endif %}
    <div class="meta-row">
      {% if thesis.university %}<span class="chip">{{ thesis.university|e }}</span>{% endif %}
      {% if thesis.disputation_date_display %}
      <span class="chip">Disputation: {{ thesis.disputation_date_display|e }}{% if thesis.disputation_date_tentative %} (tentative){% endif %}</span>
      {% endif %}
    </div>
    <span class="draft-badge">Draft</span>
  </header>

  {% if thesis.abstract %}
  <section class="thesis-section">
    <h2 class="section-title{{ ' highlighted' if section_color_highlight else '' }}">Abstract</h2>
    <div class="abstract-text">{{ thesis.abstract|e }}</div>
  </section>
  {% endif %}

  {% if thesis.figures %}
  <section class="thesis-section">
    <h2 class="section-title{{ ' highlighted' if section_color_highlight else '' }}">Figures</h2>
    <div class="figure-grid">
      {% for fig in thesis.figures %}
      <div class="figure-card">
        <a href="{{ fig.path|e }}" target="_blank" rel="noopener">
          <img src="{{ fig.path|e }}" alt="{{ fig.caption|e if fig.caption else 'Thesis figure' }}" loading="lazy">
        </a>
        {% if fig.caption %}<div class="figure-caption">{{ fig.caption|e }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if thesis.chapters %}
  <section class="thesis-section">
    <h2 class="section-title{{ ' highlighted' if section_color_highlight else '' }}">Chapters</h2>
    <div class="chapter-list">
      {% for chapter in thesis.chapters %}
      <article class="chapter">
        <div class="chapter-number">{{ '%02d'|format(loop.index) }}</div>
        <div class="chapter-body">
          <div class="chapter-title">{{ chapter.title|e }}</div>
          {% if chapter.text %}<div class="chapter-text">{{ chapter.text|e }}</div>{% endif %}
          {% if chapter.figures %}
          <div class="figure-grid">
            {% for fig in chapter.figures %}
            <div class="figure-card">
              <a href="{{ fig.path|e }}" target="_blank" rel="noopener">
                <img src="{{ fig.path|e }}" alt="{{ fig.caption|e if fig.caption else 'Thesis figure' }}" loading="lazy">
              </a>
              {% if fig.caption %}<div class="figure-caption">{{ fig.caption|e }}</div>{% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if thesis.pdf %}
  <footer class="page-footer">
    <a class="pdf-link" href="{{ thesis.pdf|e }}" target="_blank" rel="noopener">Download PDF version</a>
  </footer>
  {% endif %}

</div>
<script>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    function isDark() {
      var explicit = root.getAttribute('data-theme');
      if (explicit) return explicit === 'dark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function render() {
      btn.textContent = isDark() ? '☀️' : '🌙';
      btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
    }
    btn.addEventListener('click', function () {
      var next = isDark() ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('cv-theme', next); } catch (e) {}
      render();
    });
    render();
  })();
</script>
</body>
</html>
