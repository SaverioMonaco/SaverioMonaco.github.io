<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ personal.name.first|e }}'s Gym Progress</title>
<!-- Generated by cv-builder from data/gym/*.csv — private, not part of the CV/resume. -->
<script>
  (function () {
    try {
      var stored = localStorage.getItem('cv-theme');
      if (stored) document.documentElement.setAttribute('data-theme', stored);
    } catch (e) {}
  })();
</script>
<style>
  :root {
    --accent: {{ highlight_color }};
    --text: {{ text_color }};
    --secondary: {{ secondary_color }};
    --bg: #ffffff;
    --card-bg: #ffffff;
    --border: #e3e3e5;
    --chip-bg: #f4f4f6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161a;
      --card-bg: #1c1f24;
      --border: #2c2f36;
      --chip-bg: #22252b;
      --text: #e8e8e8;
      --secondary: #a6a6a6;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14161a;
    --card-bg: #1c1f24;
    --border: #2c2f36;
    --chip-bg: #22252b;
    --text: #e8e8e8;
    --secondary: #a6a6a6;
  }
  :root[data-theme="light"] {
    --bg: #ffffff;
    --card-bg: #ffffff;
    --border: #e3e3e5;
    --chip-bg: #f4f4f6;
    --text: {{ text_color }};
    --secondary: {{ secondary_color }};
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
  }
  .page {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 4vw, 2rem) 4rem;
  }
  a { color: inherit; }

  .theme-toggle {
    position: fixed;
    top: clamp(.75rem, 3vw, 1.25rem);
    right: clamp(.75rem, 3vw, 1.25rem);
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--chip-bg);
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .15s ease, transform .15s ease;
    z-index: 10;
  }
  .theme-toggle:hover, .theme-toggle:focus-visible { border-color: var(--accent); transform: translateY(-1px); }

  .page-header { margin-bottom: 1.75rem; }
  .page-header h1 {
    font-size: clamp(1.5rem, 4.5vw, 2.1rem);
    margin: 0 0 .3rem;
  }
  .last-updated {
    position: fixed;
    top: clamp(.75rem, 3vw, 1.25rem);
    right: calc(2.4rem + clamp(.75rem, 3vw, 1.25rem) + .6rem);
    font-size: .8rem;
    color: var(--secondary);
    line-height: 2.4rem;
    z-index: 10;
  }

  .chart-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.1rem 1.2rem;
    margin-bottom: 1.1rem;
  }
  .chart-title {
    font-size: .95rem;
    font-weight: 700;
    margin: 0 0 .6rem;
  }
  .chart {
    position: relative;
    touch-action: pan-y;
  }
  .chart svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid { stroke: var(--border); stroke-width: 1; }
  .grid-x { stroke: var(--border); stroke-width: 1; opacity: .55; }
  .axis-line { stroke: var(--secondary); stroke-width: 1; }
  .y-label, .x-label {
    fill: var(--secondary);
    font-size: 9.5px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  .y-label { text-anchor: end; dominant-baseline: middle; }
  .x-label { text-anchor: middle; }
  .line { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .end-dot { fill: var(--accent); stroke: var(--card-bg); stroke-width: 2; }
  .hover-dot { fill: var(--accent); stroke: var(--card-bg); stroke-width: 2; opacity: 0; }
  .crosshair { stroke: var(--secondary); stroke-width: 1; opacity: 0; }

  .tooltip {
    position: absolute;
    top: 0;
    transform: translate(-50%, 0);
    background: var(--chip-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .3rem .55rem;
    font-size: .78rem;
    text-align: center;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
  }
  .tt-value { font-weight: 700; color: var(--text); }
  .tt-date { color: var(--secondary); font-size: .72rem; }
</style>
</head>
<body>
<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">🌙</button>
<div class="last-updated">Last updated: {{ last_updated|e }}</div>
<div class="page">

  <header class="page-header">
    <h1>Gym Progress</h1>
  </header>

  <div id="gym-charts">
    {% for chart in charts %}
    <div class="chart-card">
      <h2 class="chart-title">{{ chart.title|e }}</h2>
      <div class="chart" data-points='{{ chart.data|tojson }}'>
        <svg role="img" aria-label="{{ chart.title|e }} over time"></svg>
        <div class="tooltip">
          <div class="tt-value"></div>
          <div class="tt-date"></div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

</div>
<script>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    function isDark() {
      var explicit = root.getAttribute('data-theme');
      if (explicit) return explicit === 'dark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function render() {
      btn.textContent = isDark() ? '☀️' : '🌙';
      btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
    }
    btn.addEventListener('click', function () {
      var next = isDark() ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('cv-theme', next); } catch (e) {}
      render();
    });
    render();
  })();
</script>
<script>
  (function () {
    var X_MIN_ISO = {{ x_min|string|tojson }};
    var X_MAX_ISO = {{ x_max|string|tojson }};

    var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function parseISO(s) {
      var parts = s.split('-').map(Number);
      return Date.UTC(parts[0], parts[1] - 1, parts[2]);
    }
    function fmtShort(ts) {
      var d = new Date(ts);
      return MONTHS[d.getUTCMonth()] + " '" + String(d.getUTCFullYear()).slice(2);
    }
    function fmtFull(ts) {
      var d = new Date(ts);
      return MONTHS[d.getUTCMonth()] + ' ' + d.getUTCDate() + ', ' + d.getUTCFullYear();
    }
    function fmtValue(v) {
      return (Math.round(v * 10) / 10) + ' kg';
    }

    function niceNum(range, round) {
      var exponent = Math.floor(Math.log(range) / Math.LN10);
      var fraction = range / Math.pow(10, exponent);
      var niceFraction;
      if (round) {
        if (fraction < 1.5) niceFraction = 1;
        else if (fraction < 3) niceFraction = 2;
        else if (fraction < 7) niceFraction = 5;
        else niceFraction = 10;
      } else {
        if (fraction <= 1) niceFraction = 1;
        else if (fraction <= 2) niceFraction = 2;
        else if (fraction <= 5) niceFraction = 5;
        else niceFraction = 10;
      }
      return niceFraction * Math.pow(10, exponent);
    }
    function niceScale(min, max, maxTicks) {
      if (min === max) { min -= 1; max += 1; }
      var range = niceNum(max - min, false);
      var step = niceNum(range / (maxTicks - 1), true);
      var niceMin = Math.floor(min / step) * step;
      var niceMax = Math.ceil(max / step) * step;
      var ticks = [];
      for (var v = niceMin; v <= niceMax + step * 0.5; v += step) {
        ticks.push(Math.round(v * 100) / 100);
      }
      return { min: niceMin, max: niceMax, ticks: ticks };
    }

    var NS = 'http://www.w3.org/2000/svg';
    function svgEl(tag, attrs) {
      var e = document.createElementNS(NS, tag);
      for (var k in attrs) e.setAttribute(k, attrs[k]);
      return e;
    }

    var MARGIN = { left: 46, right: 14, top: 14, bottom: 26 };
    var VB_W = 760, VB_H = 190;
    var PLOT_W = VB_W - MARGIN.left - MARGIN.right;
    var PLOT_H = VB_H - MARGIN.top - MARGIN.bottom;

    var X_MIN = parseISO(X_MIN_ISO);
    var X_MAX = parseISO(X_MAX_ISO);
    var X_SPAN = Math.max(X_MAX - X_MIN, 1);

    function xPx(ts) {
      return MARGIN.left + ((ts - X_MIN) / X_SPAN) * PLOT_W;
    }

    var charts = [];

    document.querySelectorAll('.chart').forEach(function (root) {
      var raw = JSON.parse(root.getAttribute('data-points'));
      var points = raw.map(function (p) { return { t: parseISO(p[0]), v: p[1] }; });
      var svg = root.querySelector('svg');
      svg.setAttribute('viewBox', '0 0 ' + VB_W + ' ' + VB_H);

      var values = points.map(function (p) { return p.v; });
      var yDomain = niceScale(Math.min.apply(null, values), Math.max.apply(null, values), 4);
      function yPx(v) {
        return MARGIN.top + (1 - (v - yDomain.min) / (yDomain.max - yDomain.min)) * PLOT_H;
      }

      yDomain.ticks.forEach(function (tv) {
        var y = yPx(tv);
        svg.appendChild(svgEl('line', { x1: MARGIN.left, x2: VB_W - MARGIN.right, y1: y, y2: y, class: 'grid' }));
        var label = svgEl('text', { x: MARGIN.left - 8, y: y + 3 });
        label.setAttribute('class', 'y-label');
        label.textContent = String(Math.round(tv * 10) / 10);
        svg.appendChild(label);
      });

      var tickCount = 5;
      for (var i = 0; i < tickCount; i++) {
        var ts = X_MIN + (X_SPAN * i) / (tickCount - 1);
        var x = xPx(ts);
        svg.appendChild(svgEl('line', { x1: x, x2: x, y1: MARGIN.top, y2: VB_H - MARGIN.bottom, class: 'grid-x' }));
        var xLabel = svgEl('text', { x: x, y: VB_H - MARGIN.bottom + 16 });
        xLabel.setAttribute('class', 'x-label');
        xLabel.textContent = fmtShort(ts);
        svg.appendChild(xLabel);
      }

      svg.appendChild(svgEl('line', {
        x1: MARGIN.left, x2: VB_W - MARGIN.right,
        y1: VB_H - MARGIN.bottom, y2: VB_H - MARGIN.bottom,
        class: 'axis-line'
      }));

      if (points.length > 1) {
        var d = points.map(function (p, idx) {
          return (idx === 0 ? 'M' : 'L') + xPx(p.t).toFixed(1) + ',' + yPx(p.v).toFixed(1);
        }).join(' ');
        svg.appendChild(svgEl('path', { d: d, class: 'line' }));
      }

      var last = points[points.length - 1];
      svg.appendChild(svgEl('circle', { cx: xPx(last.t), cy: yPx(last.v), r: 5, class: 'end-dot' }));

      var crosshair = svgEl('line', {
        x1: 0, x2: 0, y1: MARGIN.top, y2: VB_H - MARGIN.bottom, class: 'crosshair'
      });
      var hoverDot = svgEl('circle', { r: 5, class: 'hover-dot' });
      svg.appendChild(crosshair);
      svg.appendChild(hoverDot);

      charts.push({
        points: points,
        xPx: xPx,
        yPx: yPx,
        crosshair: crosshair,
        hoverDot: hoverDot,
        tooltip: root.querySelector('.tooltip'),
        svg: svg
      });
    });

    if (!charts.length) return;

    function nearestPoint(points, ts) {
      var best = points[0], bestDist = Infinity;
      for (var i = 0; i < points.length; i++) {
        var dist = Math.abs(points[i].t - ts);
        if (dist < bestDist) { bestDist = dist; best = points[i]; }
      }
      return best;
    }

    function showAt(ts) {
      var x = xPx(ts);
      charts.forEach(function (c) {
        c.crosshair.setAttribute('x1', x);
        c.crosshair.setAttribute('x2', x);
        c.crosshair.style.opacity = 1;

        var p = nearestPoint(c.points, ts);
        var px = c.xPx(p.t), py = c.yPx(p.v);
        c.hoverDot.setAttribute('cx', px);
        c.hoverDot.setAttribute('cy', py);
        c.hoverDot.style.opacity = 1;

        var rect = c.svg.getBoundingClientRect();
        var scale = rect.width / VB_W;
        c.tooltip.querySelector('.tt-value').textContent = fmtValue(p.v);
        c.tooltip.querySelector('.tt-date').textContent = fmtFull(p.t);
        c.tooltip.style.left = Math.min(Math.max(px * scale, 42), rect.width - 42) + 'px';
        c.tooltip.style.opacity = 1;
      });
    }

    function hideAll() {
      charts.forEach(function (c) {
        c.crosshair.style.opacity = 0;
        c.hoverDot.style.opacity = 0;
        c.tooltip.style.opacity = 0;
      });
    }

    function handlePointer(e) {
      var rect = charts[0].svg.getBoundingClientRect();
      var relX = e.clientX - rect.left;
      var scale = VB_W / rect.width;
      var vbX = relX * scale;
      var clampedX = Math.min(Math.max(vbX, MARGIN.left), VB_W - MARGIN.right);
      var ts = X_MIN + ((clampedX - MARGIN.left) / PLOT_W) * X_SPAN;
      showAt(ts);
    }

    var wrap = document.getElementById('gym-charts');
    wrap.addEventListener('pointermove', handlePointer);
    wrap.addEventListener('pointerleave', hideAll);
  })();
</script>
</body>
</html>
